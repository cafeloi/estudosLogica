programa
{
	
	funcao inicio()
	{
		inteiro valor

		escreva("digite um valor qualquer e diremos se o valor é par ou impar ,>>> ")
		leia(valor)

		se (valor % 2 == 0)
		{
			 escreva("O valor que voce digitou é par")
		}

		senao
		{
		escreva("O valor que voce digitou é impar")	
		}
	}
}
