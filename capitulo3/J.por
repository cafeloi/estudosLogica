programa
{
	
	funcao inicio()
	{
	real Fahrenheit, Celsius
	Celsius = 10.00
	escreva("os graus Celsius serão convertido em Fahrenhit de 10 em 10")
	faca
	{
		 Fahrenheit = (9 * Celsius + 160)/5
		 escreva(Celsius," celsius é igual a ",Fahrenheit," Fahrenheit\n" )
		 Celsius = Celsius + 10
		
	}enquanto(Celsius < 110)
	}
}
