programa
{
	
	funcao inicio()
	{
		para (inteiro I=1; I <=20; I++ )
		{
			se (I%2 == 0)
			{
			 escreva("\no valor atual é ",I," e é um numero par")
			}
			senao
			{
				escreva("\no valor atual é ",I," e é um numero impar")
			}
		}
	}
}
