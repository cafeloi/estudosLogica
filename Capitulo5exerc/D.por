programa
{
	
inclua biblioteca Util --> u 
	funcao inicio()
	{
	inteiro A,ciclo
	  escreva("serão exibidos todos os numeros pares de 1 a 500")
	  A = 0
	  ciclo = 0
   faca{
         A = A + 2
 enquanto(ciclo == 0)
         {
         escreva("\nnumeros pares ")
         ciclo = + 1
         }
        escreva("\n",A)
        
       u.aguarde(50)
	  }enquanto(A != 500)
	  
	}
}
